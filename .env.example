# ==============================================================================
# VeraTrace Enterprise Forensic Engine — Production Environment Configuration
# ==============================================================================
# IMPORTANT:
# - Never commit actual secret keys or credentials to version control.
# - SQLite database and vault evidence storage require PERSISTENT block storage.
#   Do not deploy to ephemeral serverless containers (e.g. AWS Lambda without EFS,
#   Heroku dynos, or stateless containers) where local disk resets on restart.
# ==============================================================================

# Node Environment ('production', 'development', 'test')
# In production, strict CORS is enforced and localhost origins are rejected.
NODE_ENV=production

# Server Listen Port
PORT=4000

# Allowed CORS Origins (comma-separated for multiple origins)
# Whitelist only the production frontend domains.
ALLOWED_ORIGINS=https://veratrace-app.vercel.app

# Cryptographic Master Vault Key Passphrase (AES-256-GCM Evidence at Rest)
# If omitted, VeraTrace generates a 256-bit key in server/data/.vault_master.key.
# For production clusters or disaster recovery, provide a high-entropy secret (>= 32 chars).
VERATRACE_VAULT_KEY=replace-with-a-secure-random-passphrase-at-least-32-chars

# JWT Authentication Secret Key (HMAC-SHA256 Token Signing)
# If omitted, VeraTrace generates a 256-bit key in server/data/.auth_master.key.
# For production clusters, provide a high-entropy secret (>= 32 chars).
VERATRACE_JWT_SECRET=replace-with-a-secure-random-jwt-secret-at-least-32-chars

# Maximum Upload File Size (Default: 100MB per file)
MAX_FILE_SIZE_BYTES=104857600

# Optional Email Provider Configuration (for production password recovery dispatch)
# Leave unconfigured to keep email delivery safely disabled (zero dummy dispatch).
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=replace-with-smtp-password
# SMTP_FROM=security@veratrace-app.com
