{
  "manifest_version": 3,
  "name": "VeraTrace — Digital Evidence Capture",
  "version": "2.0.0",
  "description": "Privacy-first digital evidence capture and forensic hashing for online harassment documentation.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:4000/*",
    "https://veratrace-app.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "VeraTrace Evidence Intake"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:*/*",
        "http://127.0.0.1:*/*",
        "https://*.vercel.app/*",
        "https://veratrace-app.vercel.app/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:*/*",
      "http://127.0.0.1:*/*",
      "https://*.vercel.app/*",
      "https://veratrace-app.vercel.app/*"
    ]
  },
  "icons": {
    "48": "icon.svg",
    "128": "icon.svg"
  }
}
